{
    "name": "obsidian-image-annotator",
    "main": "main.js",
    "author": {
        "name": "Paul Fischer",
        "email": "paul.fischer@mailbox.org",
        "url": "https://github.com/paulhfischer"
    },
    "version": "1.0.0",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --ext js,ts,tsx --fix",
        "prettier": "prettier . --list-different --write"
    },
    "eslintConfig": {
        "extends": [
            "@paulhfischer/eslint-config-typescript-react"
        ],
        "rules": {
            "import/prefer-default-export": "off",
            "max-classes-per-file": "off",
            "react/jsx-props-no-spreading": "off",
            "jsx-a11y/label-has-associated-control": "off"
        },
        "ignorePatterns": [
            "main.js"
        ]
    },
    "prettier": "@paulhfischer/prettier-config",
    "license": "MIT",
    "devDependencies": {
        "@paulhfischer/eslint-config-typescript-react": "^1.22.1",
        "@paulhfischer/prettier-config": "1.12.0",
        "@types/node": "^20.11.16",
        "@types/react": "^18.2.52",
        "@types/react-dom": "^18.2.18",
        "@typescript-eslint/eslint-plugin": "6.20.0",
        "@typescript-eslint/parser": "6.20.0",
        "builtin-modules": "3.3.0",
        "esbuild": "0.20.0",
        "obsidian": "latest",
        "tslib": "2.6.2",
        "typescript": "5.3.3"
    },
    "dependencies": {
        "@fluentui/react-components": "^9.46.3",
        "@fluentui/react-icons": "^2.0.226",
        "image-size": "^1.1.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "sharp": "^0.33.2"
    }
}
